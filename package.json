{
  "name": "capstone-hub",
  "version": "0.1.0",
  "description": "CapstoneHub — Software Engineering Project Management and Lifecycle Platform",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=backend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=backend",
    "test": "npm run test --workspace=backend",
    "typecheck": "npm run typecheck --workspaces",
    "typecheck:backend": "npm run typecheck --workspace=backend",
    "typecheck:frontend": "npm run typecheck --workspace=frontend"
  },
  "keywords": [
    "project-management",
    "capstone",
    "agile",
    "srs"
  ],
  "author": "",
  "license": "ISC"
}
